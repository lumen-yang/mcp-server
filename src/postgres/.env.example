TENCENTCLOUD_SECRET_ID={Your SecretId}
TENCENTCLOUD_SECRET_KEY={Your SecretKey}
MCP_SERVER_SSE_PORT=9000

# ===== Guard 安全画像（可选）=====
# 通过 GUARD_PROFILE 指定当前生效的画像名，不同画像的限制策略可以在本文件中
# 同时并存（见下方 dev/test 示例），切换环境时只需改这一行 + 重启进程，
# 不需要逐项修改 SCOPE_ENABLED / INSTANCE_SCOPE / REGION_SCOPE。
# 留空则直接使用不带前缀的全局变量（等价于旧版本行为）。
GUARD_PROFILE=test

# ---- dev 画像：本地开发，不限定 region/instance 范围（写操作仍受 READ_ONLY 总闸控制）----
GUARD_DEV_SCOPE_ENABLED=false

# ---- test 画像：测试环境，锁定到指定实例/地域，防止误操作生产资源 ----
GUARD_TEST_SCOPE_ENABLED=true
GUARD_TEST_INSTANCE_SCOPE=postgres-xxxxxxxx
GUARD_TEST_REGION_SCOPE=ap-guangzhou

# ---- 未设置 GUARD_PROFILE 时生效的全局默认值（向后兼容） ----
READ_ONLY=true
SCOPE_ENABLED=true
INSTANCE_SCOPE=
REGION_SCOPE=
